# Copy this file to backend/.env and replace every CHANGE_ME value.
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_50_RANDOM_CHARACTERS
JWT_SIGNING_KEY=CHANGE_ME_WITH_A_DIFFERENT_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com

# Enable this only when a trusted reverse proxy sets X-Forwarded-Proto.
DJANGO_TRUST_PROXY_HEADERS=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000

# Docker Compose database connection and bootstrap values.
POSTGRES_DB=habit_tracker
POSTGRES_USER=habit
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql://habit:CHANGE_ME_DATABASE_PASSWORD@db:5432/habit_tracker

# Runtime tuning.
RUN_MIGRATIONS=true
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
GUNICORN_FORWARDED_ALLOW_IPS=*
DJANGO_LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
THROTTLE_ANON=30/minute
THROTTLE_USER=300/minute
THROTTLE_LOGIN=10/minute
THROTTLE_REGISTER=5/hour

# Configure a maintained SMTP relay before enabling email features.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
